# Modo "Sitio en construcción".
#   true  -> muestra la pantalla de "Sitio en construcción"
#   false -> muestra el sitio real
# Copia este archivo a `.env` para usarlo en local, o define la variable en Vercel.
VITE_UNDER_CONSTRUCTION=true

# --- Formulario de contacto (SMTP propio de Hostinger) ---
# Estas variables son del SERVIDOR (sin prefijo VITE_): no se exponen al navegador.
# Configúralas en Vercel (Settings → Environment Variables). SMTP_PASS = Sensitive.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@tecnofix.tech
SMTP_PASS=
CONTACT_TO=contacto@tecnofix.tech
